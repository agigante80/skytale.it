---
import Base from '../layouts/Base.astro';
---

<Base title="404 - Not Found | Skytale.it">
  <section class="py-32 text-center">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-8xl font-bold text-[var(--color-accent)]" style="font-family: var(--font-heading);">404</p>
      <h1 class="mt-4 text-2xl font-bold" style="font-family: var(--font-heading);">Page not found</h1>
      <p class="mt-2 text-[var(--color-text-muted)]">The cipher couldn't be decoded. This page doesn't exist.</p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold text-sm hover:bg-[var(--color-accent-hover)] transition-colors">
        Back to Home
      </a>
    </div>
  </section>
</Base>
