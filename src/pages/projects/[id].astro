---
import Base from '../../layouts/Base.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.skytale.it/" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://www.skytale.it/projects/" },
    { "@type": "ListItem", "position": 3, "name": project.data.title, "item": `https://www.skytale.it/projects/${project.id}/` },
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": project.data.title,
  "description": project.data.description,
  "author": { "@id": "https://www.skytale.it/#andrea" },
  "programmingLanguage": project.data.techStack,
  "url": `https://www.skytale.it/projects/${project.id}/`,
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://www.skytale.it/projects/${project.id}/` },
  ...(project.data.githubUrl ? { "codeRepository": project.data.githubUrl } : {}),
};
---

<Base title={`${project.data.title} | Andrea Gigante`} description={project.data.description} schema={[breadcrumbSchema, softwareSchema]}>
  <article class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back link -->
      <a href="/projects" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors inline-flex items-center gap-1 mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
        Back to Projects
      </a>

      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)]" style="font-family: var(--font-mono);">
            {project.data.category}
          </span>
          {project.data.metrics && (
            <span class="text-xs font-medium text-[var(--color-cta)]" style="font-family: var(--font-mono);">
              {project.data.metrics}
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold mb-4" style="font-family: var(--font-heading);">
          {project.data.title}
        </h1>

        <p class="text-lg text-[var(--color-text-muted)] mb-6">
          {project.data.description}
        </p>

        <!-- Tech stack -->
        <div class="flex flex-wrap gap-2 mb-6">
          {project.data.techStack.map(tech => (
            <span class="text-xs px-2.5 py-1 rounded bg-[var(--color-surface)] text-[var(--color-text-muted)] border border-[var(--color-border)]" style="font-family: var(--font-mono);">
              {tech}
            </span>
          ))}
        </div>

        <!-- Action buttons -->
        <div class="flex flex-wrap gap-3">
          {project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold text-sm hover:bg-[var(--color-accent-hover)] transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              View Source
            </a>
          )}
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] font-semibold text-sm hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              Live Demo
            </a>
          )}
        </div>

        <ShareButtons
          url={`https://www.skytale.it/projects/${project.id}/`}
          title={project.data.title}
        />
      </div>

      <!-- Content -->
      <div class="prose prose-invert prose-lg max-w-none
        prose-headings:font-[family-name:var(--font-heading)]
        prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
        prose-p:text-[var(--color-text-muted)]
        prose-strong:text-[var(--color-text)]
        prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
        prose-li:text-[var(--color-text-muted)]
        prose-code:text-[var(--color-accent)] prose-code:font-[family-name:var(--font-mono)]
      ">
        <Content />
      </div>
    </div>
  </article>
</Base>
