---
import Base from '../../layouts/Base.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import StatStrip from '../../components/StatStrip.astro';
import AudienceCards from '../../components/AudienceCards.astro';
import QuickStart from '../../components/QuickStart.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import { getCollection, render } from 'astro:content';
import { getAllArticles } from '../../lib/articles';
import { execFileSync } from 'node:child_process';
import liveStats from '../../data/stats.json';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const relatedArticles = project.data.relatedArticles.length > 0
  ? (await getAllArticles()).filter(a => project.data.relatedArticles.includes(a.slug))
  : [];

/* === Resolve "last modified" from git for the SoftwareSourceCode schema === */
const projectFile = `src/content/projects/${project.id}.mdx`;
let dateModified = new Date().toISOString();
try {
  const iso = execFileSync('git', ['log', '-1', '--format=%aI', '--', projectFile], {
    stdio: ['pipe', 'pipe', 'ignore'],
  }).toString().trim();
  if (iso) dateModified = iso;
} catch {
  /* git unavailable; fall back to build time */
}

/* === Stat strip: merge live numbers + manual frontmatter entries === */
const live = (liveStats as Record<string, any>)[project.id] ?? {};
function formatK(n: number) {
  if (n < 1000) return n.toString();
  if (n < 10000) {
    const t = (n / 1000).toFixed(1);
    return (t.endsWith('.0') ? t.slice(0, -2) : t) + 'k';
  }
  return Math.round(n / 1000) + 'k';
}
const liveCards: { value: string; unit?: string; label: string; sub?: string }[] = [];
if (typeof live.npmDownloads === 'number') {
  liveCards.push({
    value: formatK(live.npmDownloads),
    label: 'npm downloads / mo',
    sub: live.version ? `v${live.version}` : undefined,
  });
}
if (typeof live.dockerPulls === 'number') {
  liveCards.push({
    value: formatK(live.dockerPulls),
    label: 'Docker pulls',
    sub: 'total · Docker Hub',
  });
}
if (typeof live.stars === 'number') {
  liveCards.push({
    value: live.stars.toString(),
    label: 'GitHub stars',
    sub: typeof live.forks === 'number' ? `${live.forks} forks` : undefined,
  });
}
/* Live cards lead; frontmatter cards fill the remaining slots, capped at 4. */
const manualCards = project.data.stats ?? [];
const statCards = [...liveCards, ...manualCards].slice(0, 4);

/* Resolved version: live wins, frontmatter fallback */
const version = live.version ?? project.data.version;

/* === Status pill styles === */
const statusStyles: Record<typeof project.data.status, string> = {
  active: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  maintained: 'bg-[var(--color-accent)]/10 text-[var(--color-accent)] border-[var(--color-accent)]/30',
  experimental: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  archived: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
};
const statusLabels: Record<typeof project.data.status, string> = {
  active: 'Active',
  maintained: 'Maintained',
  experimental: 'Experimental',
  archived: 'Archived',
};

/* === Schema.org === */
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.skytale.it/" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://www.skytale.it/projects/" },
    { "@type": "ListItem", "position": 3, "name": project.data.title, "item": `https://www.skytale.it/projects/${project.id}/` },
  ],
};
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": project.data.title,
  "description": project.data.description,
  "author": { "@id": "https://www.skytale.it/#andrea" },
  "programmingLanguage": project.data.techStack,
  "keywords": project.data.techStack.join(', '),
  "dateModified": dateModified,
  "url": `https://www.skytale.it/projects/${project.id}/`,
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://www.skytale.it/projects/${project.id}/` },
  ...(project.data.githubUrl ? { "codeRepository": project.data.githubUrl } : {}),
  ...(version ? { "softwareVersion": version } : {}),
};
---

<Base
  title={`${project.data.title} | Andrea Gigante`}
  description={project.data.description}
  ogImage={project.data.heroImage}
  schema={[breadcrumbSchema, softwareSchema]}
>
  <!-- Hero -->
  <article class="py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/projects" class="back" style="font-family: var(--font-mono);">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
        All projects
      </a>

      <!-- Tier / Category / Status eyebrow -->
      <div class="hero-eb">
        <span class="tier">Tier · 0{project.data.tier}</span>
        <span class="sep">/</span>
        <span class="cat">{project.data.category}</span>
        <span class="sep">/</span>
        <span class:list={['status', statusStyles[project.data.status]]}>
          ● {statusLabels[project.data.status]}{version ? ` · v${version}` : ''}
        </span>
      </div>

      <h1 class="hero-title">{project.data.title}</h1>

      {project.data.tagline && (
        <p class="hero-tagline">{project.data.tagline}</p>
      )}

      <p class="hero-desc">{project.data.description}</p>

      <!-- Action buttons -->
      <div class="hero-ctas">
        {project.data.githubUrl && (
          <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn primary">
            View source ↗
          </a>
        )}
        {project.data.liveUrl && (
          <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn ghost">
            Live demo ↗
          </a>
        )}
        {project.data.links?.docs && (
          <a href={project.data.links.docs} target="_blank" rel="noopener noreferrer" class="btn ghost">
            Docs ↗
          </a>
        )}
        {project.data.links?.npm && (
          <a href={project.data.links.npm} target="_blank" rel="noopener noreferrer" class="btn pkg">
            <span class="key">npm</span>
          </a>
        )}
        {project.data.links?.dockerHub && (
          <a href={project.data.links.dockerHub} target="_blank" rel="noopener noreferrer" class="btn pkg">
            <span class="key">docker</span>
          </a>
        )}
      </div>
    </div>
  </article>

  <!-- Stats strip -->
  {statCards.length > 0 && <StatStrip cards={statCards} syncedAt={live.syncedAt} />}

  <!-- Body: main + sidebar -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-10">

      <!-- Main column -->
      <div class="lg:col-span-8 lg:order-1 min-w-0">
        {project.data.heroImage && (
          <figure class="hero-image">
            <img src={project.data.heroImage} alt={`${project.data.title} hero image`} loading="eager" decoding="async" />
          </figure>
        )}

        <!-- Audience cards (frontmatter-driven) -->
        {project.data.audience && project.data.audience.length > 0 && (
          <AudienceCards cards={project.data.audience} />
        )}

        <!-- MDX prose body: problem, key moves, architecture, decisions -->
        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:font-[family-name:var(--font-display)]
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-[var(--color-border)]
          prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-2
          prose-p:text-[var(--color-text-muted)]
          prose-strong:text-[var(--color-text)]
          prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
          prose-li:text-[var(--color-text-muted)]
          prose-code:text-[var(--color-accent)] prose-code:font-[family-name:var(--font-mono)] prose-code:bg-[var(--color-surface)] prose-code:px-1 prose-code:rounded
          prose-pre:bg-[var(--color-surface)] prose-pre:border prose-pre:border-[var(--color-border)] prose-pre:rounded prose-pre:text-[var(--color-text)]
        ">
          <Content />
        </div>

        <!-- Quick start (frontmatter-driven) -->
        {project.data.quickstart && (
          <div class="mt-12">
            <QuickStart
              primaryLabel={project.data.quickstart.primaryLabel}
              primaryCode={project.data.quickstart.primaryCode}
              altLabel={project.data.quickstart.altLabel}
              altCode={project.data.quickstart.altCode}
              docsHref={project.data.quickstart.docsHref}
            />
          </div>
        )}

        <!-- Comparison table (frontmatter-driven) -->
        {project.data.comparison && (
          <div class="mt-12">
            <ComparisonTable
              thisProjectLabel={project.data.title}
              competitors={project.data.comparison.competitors}
              rows={project.data.comparison.rows}
              snapshotDate={project.data.comparison.snapshotDate}
              caption={project.data.comparison.caption}
            />
          </div>
        )}

        <!-- Related articles -->
        {relatedArticles.length > 0 && (
          <section class="mt-16 pt-10 border-t border-[var(--color-border)]">
            <div class="flex items-center gap-3 mb-6 text-[11px] uppercase tracking-[0.14em] text-[var(--color-accent)]" style="font-family: var(--font-mono);">
              <span class="inline-block w-6 h-px bg-[var(--color-accent)]"></span>
              <span>Wrote about this</span>
            </div>
            <ul class="space-y-4">
              {relatedArticles.map(article => (
                <li>
                  <a href={`/articles/${article.slug}`} class="group block p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)]/50 transition-colors">
                    <div class="flex items-center gap-2 mb-1 text-xs text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
                      <span class="text-[var(--color-accent)]">{article.platform === 'linkedin' ? '↗ LinkedIn' : '↗ Medium'}</span>
                      <span>•</span>
                      <time>{article.date.toISOString().slice(0, 10)}</time>
                    </div>
                    <h3 class="font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors" style="font-family: var(--font-display);">
                      {article.title}
                    </h3>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 lg:order-2 lg:sticky lg:top-24 lg:self-start space-y-6">
        <div class="side-block">
          <h4>Tech stack</h4>
          <div class="stack">
            {project.data.techStack.map(tech => (
              <span>{tech}</span>
            ))}
          </div>
        </div>

        <div class="side-block">
          <h4>Metadata</h4>
          <div class="meta">
            {version && <div><b>Version</b><span>v{version}</span></div>}
            <div><b>Status</b><span>{statusLabels[project.data.status]}</span></div>
            <div><b>License</b><span>MIT</span></div>
            {live.releasedAt && (
              <div><b>Last release</b><span>{new Date(live.releasedAt).toISOString().slice(0, 10)}</span></div>
            )}
            <div><b>Last edit</b><span>{dateModified.slice(0, 10)}</span></div>
          </div>
        </div>

        <div class="side-block">
          <h4>Share</h4>
          <ShareButtons url={`https://www.skytale.it/projects/${project.id}/`} title={project.data.title} />
        </div>
      </aside>

    </div>
  </div>
</Base>

<style>
  .back {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: 28px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    transition: color .15s;
  }
  .back:hover { color: var(--color-accent); }

  .hero-eb {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }
  .hero-eb .tier { color: var(--color-accent); }
  .hero-eb .sep { color: var(--color-border); }
  .hero-eb .status {
    padding: 2px 7px;
    border-radius: 3px;
    border: 1px solid;
    font-size: 10px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 4.5vw, 54px);
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }
  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.35;
    color: var(--color-accent);
    margin: 0 0 18px;
    max-width: 40ch;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .hero-desc {
    font-size: 17px;
    color: var(--color-text-muted);
    line-height: 1.55;
    max-width: 60ch;
    margin: 0 0 28px;
  }
  .hero-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all .2s;
  }
  .btn.primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .btn.primary:hover { background: var(--color-accent-hover); }
  .btn.ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }
  .btn.ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .btn.pkg {
    background: var(--color-surface);
    color: var(--color-text-muted);
    border-color: var(--color-border);
    font-size: 10px;
  }
  .btn.pkg:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .btn.pkg .key { color: var(--color-accent); }

  .hero-image {
    margin: 0 0 40px;
  }
  .hero-image img {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    display: block;
  }

  .side-block {
    padding: 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .side-block h4 {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 12px;
    font-weight: 500;
  }
  .stack { display: flex; flex-wrap: wrap; gap: 5px; }
  .stack span {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 7px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: 3px;
    letter-spacing: 0.04em;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }
  .meta div { padding: 6px 0; border-top: 1px dashed var(--color-border); display: flex; justify-content: space-between; }
  .meta div:first-child { border-top: none; padding-top: 0; }
  .meta b {
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .meta span { color: var(--color-text); }
</style>
