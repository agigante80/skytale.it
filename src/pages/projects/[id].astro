---
import Base from '../../layouts/Base.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection, render } from 'astro:content';
import { getAllArticles } from '../../lib/articles';
import { execFileSync } from 'node:child_process';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const relatedArticles = project.data.relatedArticles.length > 0
  ? (await getAllArticles()).filter(a => project.data.relatedArticles.includes(a.slug))
  : [];

const projectFile = `src/content/projects/${project.id}.mdx`;
let dateModified = new Date().toISOString();
try {
  const iso = execFileSync('git', ['log', '-1', '--format=%aI', '--', projectFile], {
    stdio: ['pipe', 'pipe', 'ignore'],
  }).toString().trim();
  if (iso) dateModified = iso;
} catch {
  // git unavailable (e.g. shallow build env); fall back to build time
}

const statusStyles: Record<typeof project.data.status, string> = {
  active: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  maintained: 'bg-[var(--color-accent)]/10 text-[var(--color-accent)] border-[var(--color-accent)]/30',
  experimental: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  archived: 'bg-slate-500/10 text-slate-400 border-slate-500/30',
};

const statusLabels: Record<typeof project.data.status, string> = {
  active: 'Active development',
  maintained: 'Maintained',
  experimental: 'Experimental',
  archived: 'Archived',
};

// Parse metric string ("62 tools | Production-ready | Docker") into pieces
// so leading numeric tokens can render in accent. Mirrors ProjectCard.
const metricParts: { kind: 'num' | 'word' | 'sep'; value: string }[] = [];
if (project.data.metrics) {
  const chunks = project.data.metrics.split('|').map(s => s.trim()).filter(Boolean);
  chunks.forEach((chunk, i) => {
    const match = chunk.match(/^(\d[\d,.]*)(\s+.*)?$/);
    if (match) {
      metricParts.push({ kind: 'num', value: match[1] });
      if (match[2]) metricParts.push({ kind: 'word', value: match[2].trim() });
    } else {
      metricParts.push({ kind: 'word', value: chunk });
    }
    if (i < chunks.length - 1) metricParts.push({ kind: 'sep', value: '·' });
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.skytale.it/" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://www.skytale.it/projects/" },
    { "@type": "ListItem", "position": 3, "name": project.data.title, "item": `https://www.skytale.it/projects/${project.id}/` },
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": project.data.title,
  "description": project.data.description,
  "author": { "@id": "https://www.skytale.it/#andrea" },
  "programmingLanguage": project.data.techStack,
  "keywords": project.data.techStack.join(', '),
  "dateModified": dateModified,
  "url": `https://www.skytale.it/projects/${project.id}/`,
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://www.skytale.it/projects/${project.id}/` },
  ...(project.data.githubUrl ? { "codeRepository": project.data.githubUrl } : {}),
};
---

<Base
  title={`${project.data.title} | Andrea Gigante`}
  description={project.data.description}
  ogImage={project.data.heroImage}
  schema={[breadcrumbSchema, softwareSchema]}
>
  <article class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back link -->
      <a href="/projects" class="text-xs uppercase tracking-[0.08em] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors inline-flex items-center gap-2 mb-8" style="font-family: var(--font-mono);">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
        Back to Projects
      </a>

      <!-- Title + lede, full width above the grid -->
      <div class="mb-10 lg:mb-12">
        <!-- Tier · Category eyebrow, mirrors home-page card hierarchy -->
        <div class="flex items-center gap-3 mb-4 text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
          <span class="text-[var(--color-accent)]">Tier · 0{project.data.tier}</span>
          <span class="text-[var(--color-border)]">/</span>
          <span>{project.data.category}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-5 leading-tight" style="font-family: var(--font-display);">
          {project.data.title}
        </h1>
        <p class="text-xl sm:text-2xl text-[var(--color-text-muted)] leading-relaxed font-light max-w-3xl">
          {project.data.description}
        </p>
      </div>

      <!-- Two-column body on lg; stacks on mobile -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-10">
        <!-- Main column -->
        <div class="lg:col-span-8 lg:order-1 min-w-0">
          {project.data.heroImage && (
            <figure class="mb-10 -mx-4 sm:mx-0">
              <img
                src={project.data.heroImage}
                alt={`${project.data.title} hero image`}
                loading="eager"
                decoding="async"
                class="w-full rounded-lg border border-[var(--color-border)]"
              />
            </figure>
          )}

          <div class="prose prose-invert prose-lg max-w-none
            prose-headings:font-[family-name:var(--font-display)]
            prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-[var(--color-border)]
            prose-p:text-[var(--color-text-muted)]
            prose-strong:text-[var(--color-text)]
            prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
            prose-li:text-[var(--color-text-muted)]
            prose-code:text-[var(--color-accent)] prose-code:font-[family-name:var(--font-mono)]
          ">
            <Content />
          </div>

          {relatedArticles.length > 0 && (
            <section class="mt-16 pt-10 border-t border-[var(--color-border)]">
              <h2 class="text-xl font-semibold mb-6" style="font-family: var(--font-display);">
                Wrote about this
              </h2>
              <ul class="space-y-4">
                {relatedArticles.map(article => (
                  <li>
                    <a
                      href={`/articles/${article.slug}`}
                      class="group block p-4 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)]/50 transition-colors"
                    >
                      <div class="flex items-center gap-2 mb-1 text-xs text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
                        <span>{article.platform === 'linkedin' ? 'LinkedIn' : 'Medium'}</span>
                        <span>•</span>
                        <time>{article.date.toISOString().slice(0, 10)}</time>
                      </div>
                      <h3 class="font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
                        {article.title}
                      </h3>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <!-- Sidebar: status, metric ribbon, tech stack, action buttons, share. Sticky on lg. -->
        <aside class="lg:col-span-4 lg:order-2 lg:sticky lg:top-24 lg:self-start space-y-6">
          <!-- Status -->
          <div class="flex flex-wrap gap-2">
            <span class:list={["text-[10px] uppercase tracking-[0.1em] font-medium px-2.5 py-1 rounded border", statusStyles[project.data.status]]} style="font-family: var(--font-mono);">
              {statusLabels[project.data.status]}
            </span>
          </div>

          <!-- Metric ribbon (matches ProjectCard treatment) -->
          {project.data.metrics && metricParts.length > 0 && (
            <div class="metric-ribbon">
              {metricParts.map(part => (
                part.kind === 'num'
                  ? <span class="num">{part.value}</span>
                  : part.kind === 'sep'
                    ? <span class="sep">·</span>
                    : <span class="word">{part.value}</span>
              ))}
            </div>
          )}

          <!-- Tech stack -->
          <div>
            <h2 class="text-[10px] uppercase tracking-[0.12em] text-[var(--color-text-muted)] mb-2" style="font-family: var(--font-mono);">
              Tech stack
            </h2>
            <div class="flex flex-wrap gap-2">
              {project.data.techStack.map(tech => (
                <span class="text-[10px] px-2 py-0.5 rounded border border-[var(--color-border)] text-[var(--color-text-muted)] tracking-[0.04em]" style="font-family: var(--font-mono);">
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Action buttons -->
          {(project.data.githubUrl || project.data.liveUrl) && (
            <div class="flex flex-col gap-3">
              {project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded text-xs uppercase tracking-[0.08em] bg-[var(--color-accent)] text-[var(--color-bg)] font-medium hover:bg-[var(--color-accent-hover)] transition-colors"
                  style="font-family: var(--font-mono);"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  View Source
                </a>
              )}
              {project.data.liveUrl && (
                <a
                  href={project.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded border border-[var(--color-border)] text-[var(--color-text-muted)] text-xs uppercase tracking-[0.08em] font-medium hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
                  style="font-family: var(--font-mono);"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  Live Demo
                </a>
              )}
            </div>
          )}

          <!-- Share -->
          <div class="pt-2 border-t border-[var(--color-border)]">
            <ShareButtons
              url={`https://www.skytale.it/projects/${project.id}/`}
              title={project.data.title}
            />
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>

<style>
  .metric-ribbon {
    background: var(--color-surface-2, color-mix(in oklab, var(--color-surface) 80%, black));
    border-left: 2px solid var(--color-accent);
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text);
    letter-spacing: 0.06em;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: baseline;
    text-transform: uppercase;
    border-radius: 0 4px 4px 0;
  }
  .metric-ribbon .num {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .metric-ribbon .sep { color: var(--color-text-muted); }
  .metric-ribbon .word { color: var(--color-text); }
</style>
