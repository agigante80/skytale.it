---
import Base from '../../layouts/Base.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getAllArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const formattedDate = article.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const summary = article.tldr ?? article.description;

const platformLabel = article.platform === 'linkedin' ? 'LinkedIn' : 'Medium';
const platformCTA = article.platform === 'linkedin'
  ? 'Read full article on LinkedIn'
  : 'Read full article on Medium';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.skytale.it/" },
    { "@type": "ListItem", "position": 2, "name": "Articles", "item": "https://www.skytale.it/articles/" },
    { "@type": "ListItem", "position": 3, "name": article.title, "item": `https://www.skytale.it/articles/${article.slug}/` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.description,
  "datePublished": article.date.toISOString(),
  "author": { "@id": "https://www.skytale.it/#andrea" },
  "publisher": { "@id": "https://www.skytale.it/#website" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://www.skytale.it/articles/${article.slug}/` },
  "url": `https://www.skytale.it/articles/${article.slug}/`,
  "keywords": article.tags.join(', '),
  ...(article.image ? { "image": `https://www.skytale.it${article.image}` } : {}),
};
---

<Base
  title={`${article.title} | Andrea Gigante`}
  description={article.description}
  ogImage={article.image}
  ogType="article"
  schema={[breadcrumbSchema, articleSchema]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={article.date.toISOString()} />
    <meta property="article:author" content="https://www.skytale.it/#andrea" />
    {article.tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>
  <article class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back link -->
      <a href="/articles" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors inline-flex items-center gap-1 mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
        Back to Articles
      </a>

      <!-- Cover image -->
      {article.image ? (
        <div class="aspect-video overflow-hidden rounded-xl bg-[var(--color-bg)] mb-8">
          <img
            src={article.image}
            alt={article.title}
            class="w-full h-full object-cover"
          />
        </div>
      ) : (
        <div class="aspect-video rounded-xl bg-[var(--color-surface)] border border-[var(--color-border)] flex items-center justify-center mb-8">
          <span class="text-6xl text-[var(--color-accent)] opacity-20" style="font-family: var(--font-heading);">
            {article.platform === 'medium' ? 'M' : 'in'}
          </span>
        </div>
      )}

      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <!-- Platform badge -->
          {article.platform === 'medium' ? (
            <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-[var(--color-border)] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
              Medium
            </span>
          ) : (
            <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-[var(--color-border)] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </span>
          )}
          <time class="text-xs text-[var(--color-text-muted)]" style="font-family: var(--font-mono);" datetime={article.date.toISOString()}>
            {formattedDate}
          </time>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold mb-6" style="font-family: var(--font-heading);">
          {article.title}
        </h1>

        <!-- Tags -->
        {article.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-8">
            {article.tags.map(tag => (
              <span class="text-xs px-2.5 py-1 rounded bg-[var(--color-surface)] text-[var(--color-text-muted)] border border-[var(--color-border)]" style="font-family: var(--font-mono);">
                {tag}
              </span>
            ))}
          </div>
        )}

        <hr class="border-[var(--color-border)] mb-8" />

        <!-- TL;DR -->
        <div class="mb-10">
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-3" style="font-family: var(--font-mono);">TL;DR</p>
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
            {summary}
          </p>
        </div>

        <!-- CTA -->
        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold text-sm hover:bg-[var(--color-accent-hover)] transition-colors"
        >
          {platformLabel === 'LinkedIn' ? (
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          ) : (
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
          )}
          {platformCTA}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>

        <ShareButtons
          url={`https://www.skytale.it/articles/${article.slug}/`}
          title={article.title}
        />
      </div>
    </div>
  </article>
</Base>
