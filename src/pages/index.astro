---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ScytaleBand from '../components/ScytaleBand.astro';
import { getCollection } from 'astro:content';
import { getAllArticles } from '../lib/articles';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.tier - b.data.tier || a.data.title.localeCompare(b.data.title));

const recentArticles = (await getAllArticles()).slice(0, 3);

// Cycling messages for the homepage scytale band. Edit freely.
const scytaleCycle = [
  "WRAP TO DECODE",
  "COFFEE THEN CODE",
  "BUILT NOT POSTED",
  "HIDDEN IN PLAIN",
  "READ THE README",
];
---

<Base
  title="Andrea Gigante | Principal Product Manager at Oracle NetSuite"
  description="Andrea Gigante: Principal Product Manager at Oracle NetSuite. 13+ years building products across AI, security, and finance. Open-source tools, technical articles, and portfolio."
>
  <!-- Hero -->
  <section class="relative py-20 sm:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="hero-grid">
        <div class="min-w-0">
          <div class="hero-eyebrow">
            <span class="dash"></span>
            <span>Principal Product Manager · Oracle NetSuite · Málaga</span>
          </div>

          <h1 class="hero-title">
            <span class="name">Andrea Gigante.</span>
            <span class="tagline">
              13 years between <b>the business</b> and <b>the stack.</b><br />
              I ship the tools as well as the roadmaps.
            </span>
          </h1>

          <p class="hero-lede">
            Product across finance, sports betting, insurance and automotive, plus a workshop of real things behind it: <span class="muted">63-tool MCP servers, multi-agent orchestrators, VPN monitoring, automated content pipelines.</span>
          </p>

          <div class="hero-ctas">
            <a href="/projects" class="btn primary">
              View Projects
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href="/about" class="btn ghost">About Me</a>
            <a href="https://linkedin.com/in/agigante/" target="_blank" rel="noopener noreferrer" class="btn icon" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://github.com/agigante80" target="_blank" rel="noopener noreferrer" class="btn icon" aria-label="GitHub">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
          </div>
        </div>

        <div class="portrait">
          <img
            src="/images/profile.png"
            alt="Andrea Gigante"
            width="280"
            height="280"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Scytale motif divider: cycles through several decoded phrases -->
  <ScytaleBand messages={scytaleCycle} spacing={5} cycleMs={5500} />

  <!-- Featured Projects -->
  <section class="py-16 border-t border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="section-eyebrow">02 / Manifest</div>
          <h2 class="text-2xl sm:text-3xl font-bold" style="font-family: var(--font-display);">Featured projects</h2>
        </div>
        <a href="/projects" class="text-xs uppercase tracking-[0.08em] text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors hidden sm:inline-flex items-center gap-2" style="font-family: var(--font-mono);">
          All {allProjects.length} →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            category={project.data.category}
            tier={project.data.tier}
            techStack={project.data.techStack}
            githubUrl={project.data.githubUrl}
            liveUrl={project.data.liveUrl}
            slug={project.id}
            featured={false}
            metrics={project.data.metrics}
          />
        ))}
      </div>

      <a href="/projects" class="mt-6 block text-center text-xs uppercase tracking-[0.08em] text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors sm:hidden" style="font-family: var(--font-mono);">
        All projects →
      </a>
    </div>
  </section>

  <!-- Recent Articles -->
  {recentArticles.length > 0 && (
    <section class="py-16 border-t border-[var(--color-border)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-8">
          <div>
            <div class="section-eyebrow">03 / Dispatch</div>
            <h2 class="text-2xl sm:text-3xl font-bold" style="font-family: var(--font-display);">Latest articles</h2>
          </div>
          <a href="/articles" class="text-xs uppercase tracking-[0.08em] text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors hidden sm:inline-flex items-center gap-2" style="font-family: var(--font-mono);">
            All articles →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentArticles.map(article => (
            <ArticleCard
              title={article.title}
              description={article.description}
              date={article.date}
              tags={article.tags}
              url={article.url}
              platform={article.platform}
              image={article.image}
              slug={article.slug}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 1020px) {
    .hero-grid { grid-template-columns: 1fr; }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 24px;
  }
  .hero-eyebrow .dash {
    width: 32px;
    height: 1px;
    background: var(--color-accent);
    display: inline-block;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hero-title .name {
    display: block;
    font-size: clamp(44px, 6.8vw, 86px);
  }
  .hero-title .tagline {
    display: block;
    font-weight: 400;
    font-size: clamp(18px, 2.2vw, 28px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    margin-top: 14px;
  }
  .hero-title .tagline b {
    color: var(--color-text);
    font-weight: 500;
  }

  .hero-lede {
    margin-top: 32px;
    max-width: 56ch;
    font-size: 19px;
    color: var(--color-text);
    line-height: 1.5;
  }
  .hero-lede .muted { color: var(--color-text-muted); }

  .hero-ctas {
    margin-top: 36px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 20px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all .2s;
  }
  .btn.primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .btn.primary:hover { background: var(--color-accent-hover); }
  .btn.ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }
  .btn.ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .btn.icon {
    width: 44px;
    height: 44px;
    padding: 0;
    justify-content: center;
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }
  .btn.icon:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .portrait {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
  }
  .portrait::before {
    content: '';
    position: absolute;
    inset: -10%;
    background: radial-gradient(ellipse at center, color-mix(in oklab, var(--color-accent) 22%, transparent), transparent 70%);
    z-index: 0;
    pointer-events: none;
  }
  .portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media (max-width: 1020px) {
    .portrait { width: 200px; height: 200px; margin: 24px auto 0; }
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .section-eyebrow::before {
    content: '';
    height: 1px;
    width: 24px;
    background: var(--color-accent);
  }
</style>
