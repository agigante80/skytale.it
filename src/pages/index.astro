---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getAllArticles } from '../lib/articles';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const recentArticles = (await getAllArticles()).slice(0, 3);
---

<Base title="Andrea Gigante | Principal Product Manager at Oracle NetSuite" description="Andrea Gigante - Principal Product Manager at Oracle NetSuite. 13+ years building products across AI, security, and finance. Open-source tools, technical articles, and portfolio.">
  <!-- Hero -->
  <section class="relative py-20 sm:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-center">
        <div class="md:col-span-2">
          <p class="text-sm font-medium text-[var(--color-accent)] mb-4 tracking-wider uppercase" style="font-family: var(--font-mono);">Principal Product Manager</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight" style="font-family: var(--font-heading);">
            Andrea Gigante
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
            Bridging innovation and business value. I build real tools, understand infrastructure, and ship code. 13+ years turning complex problems into products that work.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="/projects" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold text-sm hover:bg-[var(--color-accent-hover)] transition-colors">
              View Projects
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href="/about" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] font-semibold text-sm hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors">
              About Me
            </a>
            <a href="https://linkedin.com/in/agigante/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-11 h-11 rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>
        </div>
        <div class="hidden md:flex justify-center">
          <div class="w-56 h-56 rounded-2xl overflow-hidden border-2 border-[var(--color-border)] shadow-lg shadow-[var(--color-accent)]/10">
            <img
              src="/images/profile.png"
              alt="Andrea Gigante"
              class="w-full h-full object-cover"
              width="224"
              height="224"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Articles -->
  {recentArticles.length > 0 && (
    <section class="py-16 border-t border-[var(--color-border)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-8">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold" style="font-family: var(--font-heading);">Latest Articles</h2>
            <p class="mt-2 text-[var(--color-text-muted)]">Thoughts on product, engineering, and AI</p>
          </div>
          <a href="/articles" class="text-sm text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors hidden sm:block">
            View all articles &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentArticles.map(article => (
            <ArticleCard
              title={article.title}
              description={article.description}
              date={article.date}
              tags={article.tags}
              url={article.url}
              platform={article.platform}
              image={article.image}
              slug={article.slug}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Featured Projects -->
  <section class="py-16 border-t border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold" style="font-family: var(--font-heading);">Featured Projects</h2>
          <p class="mt-2 text-[var(--color-text-muted)]">Real tools I've designed and built</p>
        </div>
        <a href="/projects" class="text-sm text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors hidden sm:block">
          View all projects &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            category={project.data.category}
            tier={project.data.tier}
            techStack={project.data.techStack}
            githubUrl={project.data.githubUrl}
            liveUrl={project.data.liveUrl}
            slug={project.id}
            featured={false}
            metrics={project.data.metrics}
          />
        ))}
      </div>

      <a href="/projects" class="mt-6 block text-center text-sm text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors sm:hidden">
        View all projects &rarr;
      </a>
    </div>
  </section>
</Base>
