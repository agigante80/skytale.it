---
import Base from '../layouts/Base.astro';
import ScytaleBand from '../components/ScytaleBand.astro';

const skillGroups = [
  {
    name: "Product & Strategy",
    skills: ["Product Management", "Roadmap Design", "Stakeholder Management", "Data-Driven Decisions", "User Research"],
  },
  {
    name: "Agile & Delivery",
    skills: ["Scrum", "Kanban", "SAFe", "Waterfall-to-Agile Transitions", "Story Mapping"],
  },
  {
    name: "AI & Agents",
    skills: ["MCP Servers", "Multi-Agent Orchestration", "Prompt Engineering", "OpenAI API", "AI Content Pipelines"],
  },
  {
    name: "Engineering",
    skills: ["TypeScript", "Python", "Node.js", "Docker", "CI/CD", "REST APIs"],
  },
  {
    name: "Security & Infra",
    skills: ["VPN Monitoring", "DNS Security", "Self-Hosting", "WireGuard", "Linux"],
  },
];

const industries = ["Sports Betting", "Insurance", "Automotive", "Finance"];
const languages = [
  { name: "English", level: "Fluent" },
  { name: "Italian", level: "Native" },
  { name: "Spanish", level: "Fluent" },
];
const interests = ["Security Enthusiast", "Coffee Addict", "Sci-Fi Fan", "Chess", "Shorinji Kempo", "Linux User"];
---

<Base title="About | Andrea Gigante" description="Principal Product Manager at Oracle NetSuite. 13+ years bridging business and technology across finance, sports betting, insurance, and automotive.">
  <!-- Header -->
  <section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-start">
        <!-- Frameless caricature with soft accent glow (matches home) -->
        <div class="md:col-span-1">
          <div class="about-portrait">
            <img
              src="/images/profile.png"
              alt="Andrea Gigante"
              width="320"
              height="320"
              loading="eager"
            />
          </div>
          <div class="mt-6 space-y-1.5">
            <p class="text-[11px] uppercase tracking-[0.12em] text-[var(--color-accent)]" style="font-family: var(--font-mono);">
              Principal Product Manager
            </p>
            <p class="text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
              Oracle NetSuite
            </p>
            <p class="text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
              Málaga, Spain
            </p>
          </div>
        </div>

        <!-- Bio -->
        <div class="md:col-span-2">
          <div class="flex items-center gap-3 mb-4 text-[11px] uppercase tracking-[0.14em] text-[var(--color-accent)]" style="font-family: var(--font-mono);">
            <span class="inline-block w-8 h-px bg-[var(--color-accent)]"></span>
            <span>00 / Operator</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold mb-6" style="font-family: var(--font-display); letter-spacing: -0.02em;">
            About <span class="text-[var(--color-accent)]">Andrea Gigante</span>
          </h1>

          <div class="prose prose-lg max-w-none text-[var(--color-text-muted)] space-y-4">
            <p>
              I'm a Principal Product Manager with 13+ years of experience bridging business acumen and technical knowledge. I've led products across sports betting, insurance, automotive, and finance, turning complex problems into solutions that ship.
            </p>
            <p>
              But I'm more than a PM title. I build real tools: MCP servers with 63 tools, multi-agent orchestration systems, VPN monitoring platforms, and automated financial pipelines. I believe the best product decisions come from understanding the systems you're building on.
            </p>
            <p>
              My background spans Scrum and Kanban expertise, roadmap redesign, and leading waterfall-to-agile transitions. I'm the bridge between "what the business needs" and "how the technology works."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="py-16 border-t border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-2 text-[11px] uppercase tracking-[0.14em] text-[var(--color-accent)]" style="font-family: var(--font-mono);">
        <span class="inline-block w-8 h-px bg-[var(--color-accent)]"></span>
        <span>01 / Toolkit</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold mb-8" style="font-family: var(--font-display);">Skills & expertise</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {skillGroups.map(group => (
          <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]">
            <h3 class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)] mb-4" style="font-family: var(--font-mono);">
              {group.name}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map(skill => (
                <span class="text-xs px-2.5 py-1 rounded border border-[var(--color-border)] text-[var(--color-text-muted)]">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Industries -->
      <div class="mt-8 p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]">
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)] mb-4" style="font-family: var(--font-mono);">
          Industries shipped in
        </h3>
        <div class="flex flex-wrap gap-2">
          {industries.map(industry => (
            <span class="text-xs px-2.5 py-1 rounded border border-[var(--color-border)] text-[var(--color-text-muted)]">
              {industry}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Scytale motif divider: the page where the cipher story lives -->
  <ScytaleBand
    variant="compact"
    message="WRAP THE STRIP"
    spacing={5}
    seed="about-page"
  />

  <!-- The Skytale Story -->
  <section id="origin" class="py-16 border-t border-[var(--color-border)] scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Text -->
        <div>
          <div class="flex items-center gap-3 mb-4 text-[11px] uppercase tracking-[0.14em] text-[var(--color-accent)]" style="font-family: var(--font-mono);">
            <span class="inline-block w-8 h-px bg-[var(--color-accent)]"></span>
            <span>02 / Origin</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6" style="font-family: var(--font-display);">
            Why <span class="text-[var(--color-accent)]">Skytale</span>.it?
          </h2>

          <div class="space-y-4 text-[var(--color-text-muted)]">
            <p>
              The name comes from the <strong class="text-[var(--color-text)]">scytale</strong> (σκυτάλη), an ancient Greek transposition cipher used by Spartans during military campaigns. A parchment strip wrapped around a cylinder of specific diameter; only someone with an identical cylinder could decode the message.
            </p>
            <p>
              The cipher works by spacing: characters at regular intervals along the strip form the hidden message, the rest are filler. Without the right "key" (the cylinder's diameter), the strip looks like noise. With it, the message reveals itself. Try reading every 5th character above.
            </p>
            <p>
              As a kid, I used to practice steganography with friends, hiding messages in plain sight. That early fascination with encryption and security never left me.
            </p>
            <p>
              <strong class="text-[var(--color-text)]">Skytale</strong> represents my passion for security and encryption. <strong class="text-[var(--color-text)]">.it</strong> stands for Italy, my country of origin, and Information Technology, my field.
            </p>
          </div>

          <blockquote class="mt-6 pl-4 border-l-2 border-[var(--color-accent)] text-[var(--color-text-muted)] italic">
            "For me, Skytale symbolizes clarity, precision, and secure communication, values I strive to embody in my professional journey."
          </blockquote>
        </div>

        <!-- Scytale illustration -->
        <div class="flex justify-center">
          <div class="w-full max-w-sm rounded-2xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
            <img
              src="/images/skytale.png"
              alt="Scytale, ancient Greek transposition cipher used by Spartans"
              class="w-full h-auto rounded-lg"
            />
            <p class="mt-3 text-[10px] uppercase tracking-[0.12em] text-center text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
              σκυτάλη: Spartan transposition cipher
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Languages & Interests -->
  <section class="py-16 border-t border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Languages -->
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]">
          <h3 class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)] mb-4" style="font-family: var(--font-mono);">
            Languages
          </h3>
          <div class="space-y-3">
            {languages.map(lang => (
              <div class="flex justify-between items-center">
                <span class="text-[var(--color-text)]">{lang.name}</span>
                <span class="text-[10px] uppercase tracking-[0.1em] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">{lang.level}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Interests -->
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]">
          <h3 class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)] mb-4" style="font-family: var(--font-mono);">
            Beyond work
          </h3>
          <div class="flex flex-wrap gap-2">
            {interests.map(interest => (
              <span class="text-sm px-3 py-1.5 rounded border border-[var(--color-border)] text-[var(--color-text-muted)]">
                {interest}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Frameless caricature matching the homepage hero treatment */
  .about-portrait {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
  }
  .about-portrait::before {
    content: '';
    position: absolute;
    inset: -5%;
    background: radial-gradient(ellipse at center, color-mix(in oklab, var(--color-accent) 22%, transparent), transparent 70%);
    z-index: 0;
    pointer-events: none;
  }
  .about-portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
