---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  url: string;
  platform: 'medium' | 'linkedin';
  image?: string;
  slug: string;
}

const { title, description, date, tags, platform, image, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const stampDate = date.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: '2-digit' }).replaceAll('/', '·');

// Generate a deterministic cipher-look "preview" from the slug; pure decoration.
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
function seedFromString(s: string) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) h = (h ^ s.charCodeAt(i)) * 16777619 >>> 0;
  return h;
}
function cipherLine(seed: number, length: number) {
  let s = seed;
  let out = '';
  for (let i = 0; i < length; i++) {
    s = (s * 1103515245 + 12345) >>> 0;
    out += alphabet[s % 26];
    if (i < length - 1) out += '·';
  }
  return out;
}
const seed = seedFromString(slug);
const cipherRows = [
  cipherLine(seed, 7),
  cipherLine(seed + 17, 7),
];
---

<article class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all hover:border-[var(--color-accent)]/50 hover:shadow-lg hover:shadow-[var(--color-accent)]/5 overflow-hidden">
  <a href={`/articles/${slug}`} class="block">
    {image ? (
      <div class="aspect-video overflow-hidden bg-[var(--color-bg)]">
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="cipher-cover aspect-video">
        <div class="cipher-rows">
          {cipherRows.map((row, i) => (
            <div class:list={['cipher-row', i === 1 && 'bright']}>{row}</div>
          ))}
        </div>
        <div class="cipher-stamp">// FILED {stampDate}</div>
      </div>
    )}

    <div class="p-6">
      <div class="flex items-center justify-between mb-2">
        <time class="text-xs text-[var(--color-text-muted)]" style="font-family: var(--font-mono);" datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {platform === 'medium' ? (
          <span class="text-[10px] uppercase tracking-[0.12em] text-[var(--color-accent)] inline-flex items-center gap-1" style="font-family: var(--font-mono);">
            ↗ Medium
          </span>
        ) : (
          <span class="text-[10px] uppercase tracking-[0.12em] text-[var(--color-accent)] inline-flex items-center gap-1" style="font-family: var(--font-mono);">
            ↗ LinkedIn
          </span>
        )}
      </div>

      <h3 class="mt-2 text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors" style="font-family: var(--font-display);">
        {title}
      </h3>

      <p class="mt-2 text-sm text-[var(--color-text-muted)] line-clamp-2">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="text-[10px] px-2 py-0.5 rounded border border-[var(--color-border)] text-[var(--color-text-muted)] tracking-[0.04em] uppercase" style="font-family: var(--font-mono);">
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="mt-4 text-sm text-[var(--color-accent)] group-hover:text-[var(--color-accent-hover)] transition-colors inline-flex items-center gap-1">
        Read article
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </div>
    </div>
  </a>
</article>

<style>
  .cipher-cover {
    background:
      repeating-linear-gradient(45deg, color-mix(in oklab, var(--color-accent) 8%, transparent) 0 10px, transparent 10px 22px),
      linear-gradient(135deg, color-mix(in oklab, var(--color-accent) 15%, var(--color-bg)) 0%, var(--color-bg) 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cipher-rows {
    text-align: center;
    line-height: 1.7;
  }
  .cipher-row {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.3em;
    color: color-mix(in oklab, var(--color-accent) 30%, transparent);
  }
  .cipher-row.bright {
    color: var(--color-accent);
  }
  .cipher-stamp {
    position: absolute;
    bottom: 12px;
    right: 14px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
