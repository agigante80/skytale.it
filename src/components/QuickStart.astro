---
/**
 * QuickStart: section 07 of the project template.
 *
 * Renders a code block (optionally two tabs: primary + alt) so visitors
 * can copy a Docker / npm / shell one-liner without leaving the page.
 */
interface Props {
  primaryLabel: string;
  primaryCode: string;
  altLabel?: string;
  altCode?: string;
  docsHref?: string;
  number?: string;           // section eyebrow number, e.g. "02"
}
const { primaryLabel, primaryCode, altLabel, altCode, docsHref, number } = Astro.props;
---

<section class="quickstart-block">
  <div class="eb">
    <span class="dash"></span>
    <span>{number ? `${number} / ` : ''}Quick start</span>
  </div>
  <h2>Run it in under a minute</h2>

  <div class="qs">
    {altCode && altLabel ? (
      <div class="tabs" role="tablist" aria-label="Quick start variants">
        <button type="button" class="tab active" data-target="qs-primary" role="tab" aria-selected="true">{primaryLabel}</button>
        <button type="button" class="tab" data-target="qs-alt" role="tab" aria-selected="false">{altLabel}</button>
      </div>
    ) : (
      <div class="single">{primaryLabel}</div>
    )}

    <pre class="panel active" id="qs-primary" role="tabpanel"><code>{primaryCode}</code></pre>
    {altCode && (
      <pre class="panel" id="qs-alt" role="tabpanel" hidden><code>{altCode}</code></pre>
    )}
  </div>

  {docsHref && (
    <p class="docs-link">
      <a href={docsHref}>→ Full setup guide</a>
      <span>configuration, deployment, troubleshooting</span>
    </p>
  )}
</section>

<style>
  .quickstart-block { margin-bottom: 48px; }
  .eb {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }
  .eb .dash {
    height: 1px; width: 22px;
    background: var(--color-accent);
    display: inline-block;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }
  .qs {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }
  .tabs {
    display: flex;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .tab {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all .15s;
  }
  .tab:hover { color: var(--color-text); }
  .tab.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    background: var(--color-surface);
  }
  .single {
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }
  pre.panel {
    margin: 0;
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--color-text);
    overflow-x: auto;
    white-space: pre;
  }
  pre.panel code { font-family: inherit; color: inherit; background: transparent; padding: 0; }
  pre.panel[hidden] { display: none; }

  .docs-link {
    margin: 14px 0 0;
    font-size: 13px;
  }
  .docs-link a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .docs-link a:hover { text-decoration: underline; }
  .docs-link span {
    color: var(--color-text-muted);
    margin-left: 8px;
  }
</style>

<script is:inline>
  document.querySelectorAll('.quickstart-block .tabs').forEach(tabs => {
    const block = tabs.closest('.quickstart-block');
    tabs.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;
        tabs.querySelectorAll('.tab').forEach(t => {
          t.classList.toggle('active', t === tab);
          t.setAttribute('aria-selected', String(t === tab));
        });
        block.querySelectorAll('.panel').forEach(p => {
          const on = p.id === target;
          p.classList.toggle('active', on);
          p.hidden = !on;
        });
      });
    });
  });
</script>
