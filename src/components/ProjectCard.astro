---
interface Props {
  title: string;
  description: string;
  category: string;
  tier: 1 | 2 | 3;
  techStack: string[];
  githubUrl?: string;
  liveUrl?: string;
  slug: string;
  featured?: boolean;
  metrics?: string;
}

const { title, description, category, tier, techStack, githubUrl, liveUrl, slug, featured, metrics } = Astro.props;

// Split a metric string like "62 tools | Production-ready | Docker" into pieces.
// Leading numeric tokens are emphasised in accent color.
const metricParts: { kind: 'num' | 'word' | 'sep'; value: string }[] = [];
if (metrics) {
  const chunks = metrics.split('|').map(s => s.trim()).filter(Boolean);
  chunks.forEach((chunk, i) => {
    const match = chunk.match(/^(\d[\d,.]*)(\s+.*)?$/);
    if (match) {
      metricParts.push({ kind: 'num', value: match[1] });
      if (match[2]) metricParts.push({ kind: 'word', value: match[2].trim() });
    } else {
      metricParts.push({ kind: 'word', value: chunk });
    }
    if (i < chunks.length - 1) metricParts.push({ kind: 'sep', value: '·' });
  });
}
---

<article class:list={[
  "group relative rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all hover:border-[var(--color-accent)]/50 hover:shadow-lg hover:shadow-[var(--color-accent)]/5 overflow-hidden",
  featured && "md:col-span-2"
]}>
  {tier === 1 && <span class="tier-rail" aria-hidden="true"></span>}

  <a href={`/projects/${slug}`} class="block p-6">
    <!-- Eyebrow: CATEGORY -->
    <div class="flex items-center gap-3 mb-3 text-[10px] uppercase tracking-[0.12em] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
      <span>{category}</span>
    </div>

    <!-- Title -->
    <h3 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors mb-3" style="font-family: var(--font-display);">
      {title}
    </h3>

    <!-- Metric ribbon (promoted) -->
    {metrics && (
      <div class="metric-ribbon mb-4">
        {metricParts.map(part => (
          part.kind === 'num'
            ? <span class="num">{part.value}</span>
            : part.kind === 'sep'
              ? <span class="sep">·</span>
              : <span class="word">{part.value}</span>
        ))}
      </div>
    )}

    <p class="text-sm text-[var(--color-text-muted)] mb-4 line-clamp-2">
      {description}
    </p>

    <div class="flex flex-wrap gap-2 mb-4">
      {techStack.map(tech => (
        <span class="text-[10px] px-2 py-0.5 rounded border border-[var(--color-border)] text-[var(--color-text-muted)] tracking-[0.04em]" style="font-family: var(--font-mono);">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex items-center justify-between gap-3 pt-3 border-t border-[var(--color-border)] text-[10px] uppercase tracking-[0.08em] text-[var(--color-text-muted)]" style="font-family: var(--font-mono);">
      <span>{githubUrl ? '// Open source' : liveUrl ? '// Live' : '// In progress'}</span>
      <span class="text-[var(--color-accent)] group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
        View case ↗
      </span>
    </div>
  </a>
</article>

<style>
  .tier-rail {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
  }
  .metric-ribbon {
    background: var(--color-surface-2, color-mix(in oklab, var(--color-surface) 80%, black));
    border-left: 2px solid var(--color-accent);
    padding: 10px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text);
    letter-spacing: 0.06em;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: baseline;
    text-transform: uppercase;
    border-radius: 0 4px 4px 0;
  }
  .metric-ribbon .num {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .metric-ribbon .sep { color: var(--color-text-muted); }
  .metric-ribbon .word { color: var(--color-text); }
</style>
