# Chat transcripts — the highest-value leak in the category.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
repomix-output.*
# Coverage and test caches: an absolute path in every record.
.coverage
.coverage.*
coverage.xml
htmlcov/
lcov.info
.pytest_cache/
.tox/
.nox/
# Type and lint caches.
.mypy_cache/
.ruff_cache/
# Build output: embeds the build root.
build/
*.egg-info/
*.sarif
# Environments: absolute paths in every script shebang.
venv/
env/
*.py[cod]
# Secrets. The negations are mandatory: six repos track a .env.example on purpose.
!.env.example
!.env.template
*.pem
*.key
# Editor and OS. koel tracks a .vscode/mcp.json — editor dirs are becoming assistant dirs.
.zed/
*.swp
*.swo
# --- end leak-guard baseline ---
