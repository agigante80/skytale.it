---
/**
 * AudienceCards: section 04 of the project template.
 *
 * Renders 2 to 4 "who this is for" cards. Skip when the project has a
 * single obvious audience (most T2/T3 projects).
 */
interface Audience {
  who: string;
  what: string;
}
interface Props {
  cards: Audience[];
}
const { cards } = Astro.props;
if (!cards || cards.length === 0) return null;
---

<section class="audience-block">
  <div class="eb">
    <span class="dash"></span>
    <span>Audience</span>
  </div>
  <h2>Who this is for</h2>

  <div class="grid">
    {cards.map(c => (
      <div class="card">
        <div class="who">// {c.who}</div>
        <div class="what" set:html={c.what} />
      </div>
    ))}
  </div>
</section>

<style>
  .audience-block { margin-bottom: 48px; }
  .eb {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }
  .eb .dash {
    height: 1px; width: 22px;
    background: var(--color-accent);
    display: inline-block;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 14px 16px;
  }
  .who {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .what {
    font-size: 13.5px;
    color: var(--color-text);
    line-height: 1.55;
  }
  .what :global(code) {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--color-bg);
    color: var(--color-accent);
    padding: 1px 5px;
    border-radius: 2px;
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
